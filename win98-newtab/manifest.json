{
    "manifest_version": 3,
    "name": "Win98 Bookmarks Desktop",
    "version": "1.0.0",
    "description": "Replaces the new tab page with a Windows 98 desktop showing all your bookmarks and folders as icons",
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "permissions": ["bookmarks", "storage", "unlimitedStorage"],
    "host_permissions": [
        "https://api.open-meteo.com/*",
        "https://geocoding-api.open-meteo.com/*",
        "https://*.gstatic.com/*",
        "https://isdayoff.ru/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
